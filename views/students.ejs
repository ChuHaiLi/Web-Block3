<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Danh sách sinh viên và biểu mẫu thêm sinh viên phục vụ quản lý học vụ.">
  <title>Danh sách sinh viên · Quản lý học vụ</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <% const hasFormErrors = Object.keys(errors).length > 0; %>
  <a class="skip-link" href="#main-content">Đến nội dung chính</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/students" aria-label="Quản lý học vụ — danh sách sinh viên">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M3 5.5c3.5-1.2 6.5-.5 9 1.5 2.5-2 5.5-2.7 9-1.5v13c-3.5-1.2-6.5-.5-9 1.5-2.5-2-5.5-2.7-9-1.5v-13Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M12 7v13" stroke="currentColor" stroke-width="1.7"/></svg>
        </span>
        <span><strong>Quản lý học vụ</strong><span class="brand-subtitle">Không gian quản lý sinh viên</span></span>
      </a>
      <span class="header-label">Danh sách sinh viên</span>
    </div>
  </header>

  <main id="main-content" class="page-shell">
    <div class="page-heading">
      <div>
        <p class="eyebrow">QUẢN LÝ SINH VIÊN</p>
        <h1>Danh sách sinh viên</h1>
        <p class="page-description">Thông tin học vụ rõ ràng, tập trung trong một nơi.</p>
      </div>
      <div class="student-total" aria-label="Tổng số sinh viên">
        <strong><%= totalCount %></strong><span>sinh viên</span>
      </div>
    </div>

    <% if (success) { %>
      <div class="notice notice-success" role="status">
        <strong>Đã thêm sinh viên thành công.</strong> MSSV được cấp: <strong><%= createdId %></strong>.
      </div>
    <% } %>

    <% if (deleted) { %>
      <div class="notice notice-success" role="status"><strong>Đã xóa sinh viên thành công.</strong> Danh sách đã được cập nhật.</div>
    <% } %>

    <% if (Object.keys(errors).length) { %>
      <section class="notice notice-error" role="alert" aria-labelledby="error-summary-title">
        <h2 id="error-summary-title">Chưa thể thêm sinh viên</h2>
        <p>Vui lòng kiểm tra các thông tin sau. Những thông tin khác đã được giữ lại.</p>
        <ul>
          <% for (const [field, message] of Object.entries(errors)) { %>
            <li><a href="#<%= field === 'form' ? 'create-student' : field %>"><%= message %></a></li>
          <% } %>
        </ul>
      </section>
    <% } %>

    <%- include('partials/student-form', { hasFormErrors }) %>

    <div class="workspace-grid">
      <section class="panel roster-panel" aria-labelledby="roster-title">
        <div class="panel-heading">
          <div><h2 id="roster-title">Hồ sơ sinh viên</h2><p>Danh sách thông tin đang được lưu trong hệ thống.</p></div>
          <div class="roster-heading-actions">
            <span class="count-badge"><%= resultCount %> / <%= totalCount %> hồ sơ</span>
            <% if (hasFormErrors) { %>
              <a class="submit-button add-student-button" href="#create-student">+ Thêm sinh viên</a>
            <% } else { %>
              <button class="submit-button add-student-button native-popover-control" type="button" popovertarget="create-student" popovertargetaction="show">+ Thêm sinh viên</button>
              <a class="submit-button add-student-button popover-fallback-control" href="#create-student">+ Thêm sinh viên</a>
            <% } %>
          </div>
        </div>
        <section class="search-section" aria-labelledby="search-title">
          <h3 id="search-title">Tìm kiếm &amp; lọc</h3>
          <form class="search-form" action="/students" method="get">
            <div class="search-keyword">
              <label for="search-q">Tên hoặc MSSV</label>
              <input id="search-q" name="q" type="search" value="<%= filters.q %>" maxlength="100" placeholder="Ví dụ: Nguyen hoặc 026000" autocomplete="off">
            </div>
            <div>
              <label for="filter-class">Lớp sinh hoạt</label>
              <select id="filter-class" name="className">
                <option value="">Tất cả lớp sinh hoạt</option>
                <% for (const className of classes) { %>
                  <option value="<%= className %>"<% if (filters.className === className) { %> selected<% } %>><%= className %></option>
                <% } %>
              </select>
            </div>
            <div>
              <label for="filter-major">Ngành học</label>
              <select id="filter-major" name="major">
                <option value="">Tất cả ngành</option>
                <% for (const [code, label] of Object.entries(majors)) { %>
                  <option value="<%= code %>"<% if (filters.major === code) { %> selected<% } %>><%= label %></option>
                <% } %>
              </select>
            </div>
            <div class="search-actions">
              <button class="submit-button" type="submit">Tìm kiếm / Áp dụng</button>
              <a class="reset-link" href="/students">Đặt lại bộ lọc</a>
            </div>
          </form>
          <% if (hasFilters) { %>
            <div class="active-filters" aria-label="Điều kiện đang áp dụng">
              <span class="filter-label">Đang áp dụng:</span>
              <% if (filters.q) { %><span class="filter-chip">Từ khóa: <%= filters.q %></span><% } %>
              <% if (filters.className) { %><span class="filter-chip">Lớp sinh hoạt: <%= filters.className %></span><% } %>
              <% if (filters.major) { %><span class="filter-chip">Ngành: <%= majors[filters.major] %></span><% } %>
              <% if (filters.q) { %><a class="text-link clear-search" href="<%= clearSearchUrl %>">Xóa tìm kiếm</a><% } %>
            </div>
          <% } %>
          <p class="result-count" role="status">Tìm thấy <strong><%= resultCount %></strong> / <%= totalCount %> sinh viên.</p>
        </section>
        <% if (totalCount === 0) { %>
          <div class="empty-state">
            <span class="empty-symbol" aria-hidden="true">∅</span>
            <h3>Chưa có sinh viên</h3>
            <p>Hãy dùng biểu mẫu để thêm sinh viên đầu tiên.</p>
            <p>Nhấn “+ Thêm sinh viên” phía trên để mở biểu mẫu.</p>
          </div>
        <% } else if (students.length === 0) { %>
          <div class="empty-state">
            <span class="empty-symbol" aria-hidden="true">∅</span>
            <h3>Không tìm thấy sinh viên phù hợp</h3>
            <p>Hãy thay đổi từ khóa hoặc các bộ lọc đang áp dụng.</p>
            <a class="text-link" href="/students">Đặt lại bộ lọc →</a>
          </div>
        <% } else { %>
          <div class="table-scroll" tabindex="0" role="region" aria-label="Bảng sinh viên, có thể cuộn ngang trên màn hình nhỏ">
            <table>
              <caption class="visually-hidden">Danh sách <%= students.length %> sinh viên gồm MSSV, họ tên, email, lớp sinh hoạt, ngành học và thao tác.</caption>
              <colgroup><col class="col-id"><col class="col-name"><col class="col-email"><col class="col-class"><col class="col-major"><col class="col-actions"></colgroup>
              <thead><tr><th scope="col">MSSV</th><th scope="col">Họ và tên</th><th scope="col">Email</th><th scope="col">Lớp sinh hoạt</th><th scope="col">Ngành học</th><th scope="col">Thao tác</th></tr></thead>
              <tbody>
                <% for (const student of students) { %>
                  <tr>
                    <th scope="row" class="student-id"><%= student.id %></th>
                    <td class="student-name"><%= student.name %></td>
                    <td class="student-email"><%= student.email %></td>
                    <td><span class="class-badge"><%= student.className %></span></td>
                    <td><%= majors[student.major] %></td>
                    <td class="student-actions"><a class="delete-link" href="/students/<%= encodeURIComponent(student.id.trim()) %>/delete" aria-label="Xóa sinh viên <%= student.name %>, MSSV <%= student.id %>">Xóa</a></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="table-footer">Hiển thị <%= pagination.start %>–<%= pagination.end %> / <%= resultCount %> kết quả <span>Tối đa <%= pagination.pageSize %> sinh viên/trang</span></div>
        <% } %>
        <nav class="pagination" aria-label="Phân trang danh sách sinh viên">
          <p class="pagination-summary">Trang <strong><%= pagination.page %></strong> / <%= pagination.totalPages %></p>
          <div class="pagination-links">
            <% if (pagination.previousUrl) { %>
              <a class="page-link" rel="prev" href="<%= pagination.previousUrl %>">← Trước</a>
            <% } else { %>
              <span class="page-link page-disabled" aria-disabled="true">← Trước</span>
            <% } %>
            <% for (const link of pagination.pageLinks) { %>
              <% if (link.gap) { %><span class="page-gap" aria-hidden="true">…</span><% } %>
              <% if (link.number === pagination.page) { %>
                <span class="page-link page-current" aria-current="page" aria-label="Trang <%= link.number %>, hiện tại"><%= link.number %></span>
              <% } else { %>
                <a class="page-link" href="<%= link.url %>" aria-label="Trang <%= link.number %>"><%= link.number %></a>
              <% } %>
            <% } %>
            <% if (pagination.nextUrl) { %>
              <a class="page-link" rel="next" href="<%= pagination.nextUrl %>">Sau →</a>
            <% } else { %>
              <span class="page-link page-disabled" aria-disabled="true">Sau →</span>
            <% } %>
          </div>
        </nav>
      </section>

    </div>
    <footer class="page-footer">Quản lý học vụ <span>Danh sách &amp; hồ sơ sinh viên</span></footer>
  </main>
</body>
</html>
